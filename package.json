{
  "name": "dsh-tools",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "DSH 工具整合包，包含对原有组件的增强模块",
  "exports": {
    ".": "./index.js",
    "./agents": "./components/agents/index.js",
    "./locale/*.json": "./locale/*.json",
    "./agents/locale/*.json": "./components/agents/locale/*.json",
    "./icon": "./icon.svg",
    "./agents/icon": "./components/agents/icon.svg"
  },
  "files": [
    "index.js",
    "components/agents/index.js",
    "components/agents/locale/*.json",
    "components/agents/icon.svg",
    "lib/logic.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "~1.8.6",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
