{
  "name": "dsh-tools",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "DSH 工具整合包 由多个子模块组成 每个子模块在 Plugins 页有独立的 Configure 二级页",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "dsh-tools-ami": "git+https://github.com/LingluoYusa/dsh-tools.git#path:/packages/ami"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
